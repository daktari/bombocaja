{
  // Cloudflare Workers static assets — deployed with `npx wrangler deploy`.
  // The service keeps the project's original name; bakaluti.com points at it.
  "name": "bombocaja",
  "compatibility_date": "2025-01-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // deep links (/#p=… works anyway, but any path falls back to the app)
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  }
}
